#!/bin/sh
#
# The type check runs here because a push is the last moment it is free.
#
# Vercel builds from the repo with `tsc --noEmit` in the pipeline, and it type
# checks scripts/ as well as app code, because scripts/ is real code. So a type
# error in a test harness that never ships still fails the production deploy.
# That is arguably correct, and it is a terrible way to find out: the push
# succeeds, the deploy dies four minutes later, and the site keeps serving the
# previous build while you think you shipped.
#
# It has happened twice. Both times the local check had been run BEFORE the
# last edit rather than after it. A hook does not forget the order.
#
# Skip deliberately with `git push --no-verify` if you are pushing a WIP branch.

set -e
cd "$(git rev-parse --show-toplevel)/web"
echo "pre-push: tsc --noEmit"
npx tsc --noEmit
echo "pre-push: eslint"
npx eslint .
echo "pre-push: ok"
