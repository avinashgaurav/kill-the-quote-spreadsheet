# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
# ...but the template, which carries no values, is how a reviewer knows
# which variables exist. A deeper .gitignore wins over the root one, so the
# negation has to live here.
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Harness extraction cache: real model output, keyed by prompt+file hash.
# Local only. A committed cache would let a stale reading score a changed prompt.
.cache/

# Scratch probes, throwaway by convention.
#
# A leading underscore in scripts/ has meant "temporary" all along, and five of
# them got committed anyway: a `git add -A` ran while background agents were
# writing _probe5.ts, _probe6.ts, _probe7.ts, _tmp_chase.ts and _tmp_dump.ts
# into that directory. Nothing broke, and the repo carried five files that were
# never meant to be read, in the folder a reviewer opens to see how it is
# tested.
#
# My own instructions say never `git add -A`. Convention did not stop it, so a
# rule does.
web/scripts/_*
scripts/_*
