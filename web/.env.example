# Copy to .env.local and fill in. Nothing here is committed.

# The reader, the co-pilot and the analyst are all real model calls. Without a
# key the app still runs: the calculator, the grid, provenance, exports and
# every award scenario work, and the three AI loops refuse honestly rather than
# answering from a lookup table.
ANTHROPIC_API_KEY=

# Optional. Leave LLM_PROVIDER unset for Claude Opus 5, which is what the demo
# should run on: it gives native PDF citations, and that is where the PDF
# supplier's provenance comes from. Set to "gemini" with a GEMINI_API_KEY to run
# the loops on Gemini instead, where the PDF locator falls back to a
# model-reported one and the UI says so.
# LLM_PROVIDER=gemini
# GEMINI_API_KEY=

# Unset locally: the app runs embedded Postgres (PGlite) persisted to .pglite/,
# so it is fully runnable before anyone creates a cloud database. Set to a Neon
# connection string in production and nothing else changes.
# DATABASE_URL=
