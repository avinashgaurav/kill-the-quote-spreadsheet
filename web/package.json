{
  "name": "web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "conformance": "tsx scripts/conformance.ts",
    "data:rebuild": "cd ../dataset/generators && python3 build_all.py",
    "fixture": "curl -s -X POST 'http://localhost:3000/api/dev/fixture' | tail -c 200",
    "parse-check": "tsx scripts/parse-check.ts",
    "fixture:wipe": "curl -s -X POST 'http://localhost:3000/api/dev/fixture?wipe=true' | tail -c 200",
    "demo-test": "python3 scripts/demo-test.py",
    "reader-test": "tsx scripts/reader-test.ts",
    "accuracy": "tsx scripts/accuracy.ts",
    "accuracy:photos": "tsx scripts/accuracy.ts --photos",
    "revision-test": "tsx scripts/revision-test.ts",
    "generality-test": "tsx scripts/generality-test.ts",
    "e2e-test": "python3 scripts/e2e-test.py",
    "test:all": "npm run conformance && npm run reader-test && npm run parse-check && npm run revision-test && npm run generality-test && npm run questionnaire-test && npm run regression-test",
    "regression-test": "tsx scripts/regression-test.ts",
    "questionnaire-test": "tsx scripts/questionnaire-test.ts",
    "types": "tsc --noEmit",
    "api-check": "tsx scripts/api-check.ts",
    "accuracy:fresh": "tsx scripts/accuracy.ts --all --fresh",
    "verify": "npm run types && npm run lint && npm run test:all"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.124.0",
    "@electric-sql/pglite": "^0.5.8",
    "@neondatabase/serverless": "^1.1.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cn": "^0.2.6",
    "drizzle-orm": "^0.45.2",
    "fflate": "^0.8.3",
    "lucide-react": "^1.43.0",
    "mailparser": "^3.9.23",
    "mammoth": "^1.12.2",
    "next": "16.3.4",
    "radix-ui": "^1.6.7",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "recharts": "^3.10.1",
    "shadcn": "^4.21.0",
    "sharp": "^0.35.4",
    "tw-animate-css": "^1.4.0",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/mailparser": "^3.4.6",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.4",
    "tailwindcss": "^4",
    "tsx": "^4.23.13",
    "typescript": "^5"
  }
}
